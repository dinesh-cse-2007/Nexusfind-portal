<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NexusFind | Elite Lost & Found Portal</title>
    <!-- Tailwind CSS CDN for Sleek, Modern, Handsome UI -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white min-h-screen">

    <!-- Background Glow Effects -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute -top-40 -left-40 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 -right-40 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl"></div>
    </div>

    <!-- Main Container -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

        <!-- Header Section -->
        <header class="text-center mb-12">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-sm font-medium mb-4 shadow-inner">
                <i class="fa-solid fa-bolt"></i> Cloud-Powered Campus Portal
            </div>
            <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-indigo-400 bg-clip-text text-transparent">
                Nexus<span class="text-indigo-500">Find</span>
            </h1>
            <p class="mt-3 text-slate-400 max-w-2xl mx-auto text-base sm:text-lg">
                The ultimate next-gen hub to report, track, and recover lost assets seamlessly across the institution.
            </p>
        </header>

        <!-- Flash Messages -->
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                {% for category, message in messages %}
                    <div class="mb-8 p-4 rounded-xl border {% if category == 'success' %} bg-emerald-500/10 border-emerald-500/20 text-emerald-400 {% else %} bg-rose-500/10 border-rose-500/20 text-rose-400 {% endif %} flex items-center gap-3 shadow-lg transition-all animate-bounce">
                        <i class="fa-solid {% if category == 'success' %} fa-circle-check {% else %} fa-triangle-exclamation {% endif %} text-lg"></i>
                        <span class="font-medium">{{ message }}</span>
                    </div>
                {% endfor %}
            {% endif %}
        {% endwith %}

        <!-- Grid Layout: Form & Feed -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- Left Panel: Report Item Form -->
            <div class="lg:col-span-1 bg-slate-900/60 backdrop-blur-xl border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-indigo-500 to-purple-500"></div>
                <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                    <i class="fa-solid fa-plus-circle text-indigo-400"></i> Report Asset
                </h2>

                <form action="/add" method="POST" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Asset Name / Title</label>
                        <input type="text" name="title" required placeholder="e.g., iPhone 14 Pro, Keys" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Category</label>
                        <select name="category" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all">
                            <option value="Electronics">Electronics</option>
                            <option value="Accessories">Accessories</option>
                            <option value="Documents">Documents & IDs</option>
                            <option value="Others">Others</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Status Type</label>
                        <select name="type" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all">
                            <option value="Lost">Lost Item</option>
                            <option value="Found">Found Item</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Location</label>
                        <input type="text" name="location" required placeholder="e.g., Seminar Hall, Block B" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Contact Number</label>
                        <input type="text" name="contact" required placeholder="e.g., 9876543210" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all">
                    </div>

                    <button type="submit" class="w-full mt-2 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-semibold py-3.5 px-4 rounded-xl shadow-lg shadow-indigo-500/25 transition-all transform active:scale-95 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-paper-plane"></i> Broadcast Report
                    </button>
                </form>
            </div>

            <!-- Right Panel: Live Dashboard Feed -->
            <div class="lg:col-span-2 space-y-4">
                <div class="flex items-center justify-between mb-2">
                    <h2 class="text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-broadcast-tower text-indigo-400"></i> Live Asset Feed
                    </h2>
                    <span class="px-3 py-1 bg-slate-900 border border-slate-800 rounded-full text-xs font-medium text-slate-400">
                        Total Items: {{ items|length }}
                    </span>
                </div>

                {% if items %}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {% for item in items %}
                            <div class="bg-slate-900/40 backdrop-blur-md border {% if item.status == 'Resolved' %} border-emerald-500/30 bg-emerald-950/10 {% else %} border-slate-800/80 {% endif %} rounded-2xl p-5 shadow-xl hover:border-slate-700 transition-all flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between mb-3">
                                        <span class="px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider {% if item.type == 'Lost' %} bg-rose-500/10 text-rose-400 border border-rose-500/20 {% else %} bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 {% endif %}">
                                            {{ item.type }}
                                        </span>
                                        <span class="text-xs text-slate-500 font-mono">#{{ item.id }}</span>
                                    </div>

                                    <h3 class="text-lg font-bold text-white tracking-wide mb-1">{{ item.title }}</h3>

                                    <div class="space-y-1.5 mt-3 text-sm text-slate-400">
                                        <div class="flex items-center gap-2">
                                            <i class="fa-solid fa-tag text-indigo-400 w-4"></i>
                                            <span>{{ item.category }}</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <i class="fa-solid fa-location-dot text-rose-400 w-4"></i>
                                            <span>{{ item.location }}</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <i class="fa-solid fa-phone text-emerald-400 w-4"></i>
                                            <span class="font-mono text-slate-300">{{ item.contact }}</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-5 pt-4 border-t border-slate-800/60 flex items-center justify-between">
                                    {% if item.status == 'Resolved' %}
                                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400">
                                            <i class="fa-solid fa-check-circle"></i> Recovered / Closed
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-400">
                                            <i class="fa-solid fa-clock"></i> Active Search
                                        </span>
                                        <a href="/resolve/{{ item.id }}" class="px-3 py-1.5 bg-slate-800 hover:bg-emerald-600 hover:text-white text-slate-300 rounded-lg text-xs font-medium transition-all">
                                            Mark Resolved
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-20 bg-slate-900/30 border border-slate-800 rounded-3xl">
                        <i class="fa-solid fa-box-open text-4xl text-slate-600 mb-3"></i>
                        <p class="text-slate-400 font-medium">No assets reported yet.</p>
                    </div>
                {% endif %}
            </div>

        </div>

    </div>

</body>
</html>